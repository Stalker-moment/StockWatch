{
  "name": "stockwatch-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node -e \"import('node:child_process').then(m=>m.execSync('npx next build',{stdio:'inherit',env:{...process.env,STATIC_EXPORT:'1'}}))\"",
    "start": "next start",
    "data:market": "node scripts/refresh-market.mjs",
    "data:ihsg": "node scripts/refresh-ihsg.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3"
  }
}
